# Virtual environment
venv/

# Database and raw data (too large for git, regenerated by pipeline)
data/raw/
data/db/
data/processed/

# Logs (generated output, not source)
logs/

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# OS files
.DS_Store
Thumbs.db

# Trained model binary artifacts (grow to 100MB+, regenerated by training)
# best_params.json stays tracked (small JSON, key output)
models/**/*.zip
models/**/*.npz
models/**/eval_logs/
